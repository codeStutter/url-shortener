# Base URL used to build the full short link returned to clients.
BASE_URL=http://localhost:8000

# SQLite database file path (relative to project root).
DATABASE_PATH=./data/shortener.db

# Rate limits (see slowapi syntax, e.g. "20/minute").
CREATE_RATE_LIMIT=20/minute
REDIRECT_RATE_LIMIT=200/minute

# Default expiry applied when a client does not specify one, in days. 0 = never expires.
DEFAULT_EXPIRY_DAYS=0
